# Copy to `.loop/loop.env` and fill in. That file is gitignored; this one is the template.
#
#     cp .loop/loop.env.dist .loop/loop.env
#     chmod 600 .loop/loop.env
#
# The delivery loop reads it at pre-flight. Anything already exported in your shell WINS, so a
# one-off `LOOP_MODEL=sonnet .loop/delivery-loop.sh …` still overrides what is written here.
#
# It holds secrets. Never commit it, never paste its contents into a chat, and keep it 0600.

# --- credentials -------------------------------------------------------------------------------
# Both are needed only for LOOP_SANDBOX=1: a container inherits none of your host's logins, and on
# macOS the claude credential lives in the Keychain, so there is nothing to mount.

# `claude setup-token` — opens a browser, prints a token, lasts a year.
CLAUDE_CODE_OAUTH_TOKEN=

# A GitHub token that can push the unit's branch and open its PR.
#
# Strongly preferred: a FINE-GRAINED PAT limited to this repository —
#   github.com → Settings → Developer settings → Fine-grained tokens → Generate new
#   Repository access: only this repository
#   Permissions: Contents read+write, Pull requests read+write
#
# `gh auth token` also works and needs no setup, but it hands the container your FULL user token:
# every repository you own, and the ability to merge. The scoped PAT is what makes "the loop never
# merges into production" a property of what it holds rather than a rule it could route around.
#
# Deliberately NOT put in ~/.zshrc: GH_TOKEN overrides `gh auth switch`, so a global one would
# silently hijack every interactive gh command in a repo with two accounts.
GH_TOKEN=

# --- the host's contract -----------------------------------------------------------------------

# The gates, run from the repo root in this order: by every session through /run-gates, and by the
# loop itself on the host once the closing session says OK. Semicolons separate commands.
LOOP_GATES=make lint;make test

# Optional. A command run INSIDE a worktree before it is removed, for hosts whose gates leave state
# named after the worktree directory (Docker Compose stacks, path-keyed caches).
# LOOP_CLEAN_WORKTREE=make clean-worktree

# Optional. Generated paths nobody reviews, excluded from the size the ledger records. Space-separated
# git pathspecs; lockfiles, `*.gen.*` and the spec itself are excluded already.
# LOOP_SIZE_EXCLUDES=api/openapi.json web/messages/*.json

# Optional. Tools a session must never run in this host, beyond the built-in list (merging, force
# pushes, ssh/scp, docker volume removal, kubectl, helm). Claude Code permission patterns, separated
# by semicolons. A match without `*` is exact, so `make migrate` leaves `make migrate-diff` allowed.
# LOOP_DENIALS_EXTRA=Bash(make migrate);Bash(make deploy)

# --- how the loop runs -------------------------------------------------------------------------

# 1 runs each session in a container that sees the worktree and nothing else — no ~/.ssh, so prod
# is unreachable rather than merely forbidden. Needs `.loop/sandbox/build.sh` once.
LOOP_SANDBOX=0

# The model every build session runs on (one spec phase per session, plus the closing review).
# The PR-opening session always runs on sonnet.
# LOOP_MODEL=opus

# Sessions per invocation before the unit is declared non-converging. Defaults to the number of
# phases plus two.
# MAX_SESSIONS=

# A session whose recorded peak context exceeds this is reported. It is a reading on the
# telemetry, not something the session is told: a session cannot observe its own context.
# SESSION_CONTEXT_ALARM=150000

# Wall clock per session, in seconds.
# UNIT_TIMEOUT=7200

# Anything richer than the terminal bell: `say`, terminal-notifier, a curl to your phone. It gets the
# headline as $1.
# DELIVERY_LOOP_NOTIFY=/usr/local/bin/notify-me
