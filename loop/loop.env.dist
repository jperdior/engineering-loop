# The user's settings file, `~/.config/engineering-loop/loop.env`, for every repository the loop
# builds in. `setup-loop.sh` writes it; by hand, copy this template there and fill it in:
#
#     mkdir -p ~/.config/engineering-loop
#     cp loop.env.dist ~/.config/engineering-loop/loop.env && chmod 600 ~/.config/engineering-loop/loop.env
#
# LOOP_ENV overrides the path. The delivery loop reads it at pre-flight. Anything already exported in
# your shell WINS, so a one-off `LOOP_MODEL=sonnet delivery-loop.sh …` still overrides what is here.
#
# It holds secrets. Never commit it, never paste its contents into a chat, and keep it 0600.

# --- credentials -------------------------------------------------------------------------------
# Both are needed only for LOOP_SANDBOX=1: a container inherits none of your host's logins, and on
# macOS the claude credential lives in the Keychain, so there is nothing to mount.

# `claude setup-token` — opens a browser, prints a token, lasts a year.
CLAUDE_CODE_OAUTH_TOKEN=

# A GitHub token that can push the unit's branch and open its PR.
#
# Strongly preferred: a FINE-GRAINED PAT limited to this repository —
#   github.com → Settings → Developer settings → Fine-grained tokens → Generate new
#   Repository access: only this repository
#   Permissions: Contents read+write, Pull requests read+write
#
# `gh auth token` also works and needs no setup, but it hands the container your FULL user token:
# every repository you own, and the ability to merge. The scoped PAT is what makes "the loop never
# merges into production" a property of what it holds rather than a rule it could route around.
#
# Deliberately NOT put in ~/.zshrc: GH_TOKEN overrides `gh auth switch`, so a global one would
# silently hijack every interactive gh command in a repo with two accounts.
GH_TOKEN=

# --- the host's contract is NOT here -----------------------------------------------------------
#
# The gates, the per-worktree cleanup, the generated paths and the extra denials are facts about the
# repository, so they live in each spec's `## Gates` section: /spec-writing derives them from the
# repository's own docs every time, and the loop reads them from the spec on the branch. Nothing
# about the host is configured here for the loop's sake.

# --- how the loop runs -------------------------------------------------------------------------

# Required, and deliberately left blank here: the loop refuses to run until it is 0 or 1.
#   1  runs each session in a container that sees the worktree and nothing else — no ~/.ssh, so
#      prod is unreachable rather than merely forbidden. Needs the two tokens above and the
#      plugin's `loop/sandbox/build.sh` once. `setup-loop.sh` walks through all three.
#   0  runs each session on this host, as you: your ssh keys, your gh login, and whichever Claude
#      account this shell's CLAUDE_CONFIG_DIR is logged into. `setup-loop.sh --host` records it.
LOOP_SANDBOX=

# The model every build session runs on (one spec phase per session, plus the closing review).
# The PR-opening session always runs on sonnet.
# LOOP_MODEL=opus

# Sessions per invocation before the unit is declared non-converging. Defaults to the number of
# phases plus four: one per phase, one per closing step (docs, review, archive), one spare.
# MAX_SESSIONS=

# A session whose context exceeds this many tokens is reported. Unset, the alarm is half of the
# session model's context window, which is what a phase must not fill whatever the host's docs
# weigh. It is a reading on the telemetry, not something the session is told: a session cannot
# observe its own context.
# SESSION_CONTEXT_ALARM=

# Wall clock per session, in seconds.
# UNIT_TIMEOUT=7200

# Anything richer than the terminal bell: `say`, terminal-notifier, a curl to your phone. It gets the
# headline as $1.
# DELIVERY_LOOP_NOTIFY=/usr/local/bin/notify-me
