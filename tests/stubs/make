#!/usr/bin/env bash
#
# The loop shells out to make twice: `clean-worktree` during reclaim, and `lint`/`test` in `prove`.
#
# LOOP_TEST_MAKE selects:
#
#   ok     (default) the gates pass
#   fail   the gates fail every time, which must escalate
#   flaky  the FIRST `make lint` fails and everything after passes -- a toolchain that fell over
#          (a package install dying under load) rather than a unit that is wrong. Escalating on it
#          would cost a whole unattended night for a run that was correct.
#
# A gate drains its stdin, as the real thing does: `make lint` in a host runs `docker compose`,
# which reads whatever stdin it inherits. The loop once fed its gate list to `read` through a
# heredoc and ran each gate on that same stdin, so the first gate ate every line after it and only
# `make lint` was ever proven. The drain keeps that failure visible to the suite.

set -euo pipefail

# Every target is recorded, so a case can assert that the cleanup the spec named actually ran.
printf '%s\n' "${1:-}" >> "${LOOP_TEST_DIR:-/dev/null}/make-targets.txt" 2>/dev/null || true

case "${1:-}" in
  clean-worktree) exit 0 ;;
  lint|test)
    [ -t 0 ] || cat > /dev/null
    case "${LOOP_TEST_MAKE:-ok}" in
      fail) exit 1 ;;
      flaky)
        # A file, not a variable: `make` is a fresh process every time it is called.
        seen=0
        [ ! -f "$LOOP_TEST_DIR/make-calls" ] || seen="$(cat "$LOOP_TEST_DIR/make-calls")"
        echo "$((seen + 1))" > "$LOOP_TEST_DIR/make-calls"
        [ "$seen" = 0 ] && exit 1
        exit 0
        ;;
    esac
    exit 0
    ;;
esac
exit 0
